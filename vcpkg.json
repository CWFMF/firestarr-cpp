{
  "dependencies": [
    "libgeotiff",
    {
      "name": "tiff",
      "default-features": true,
      "features": [
        "lerc",
        "libdeflate",
        "lzma",
        "webp",
        "zip",
        "zstd"
      ]
    },
    {
      "name": "proj",
      "default-features": false
    },
    {
      "name": "sqlite3",
      "default-features": false,
      "features": [
        "omit-load-extension"
      ]
    }
  ]
}